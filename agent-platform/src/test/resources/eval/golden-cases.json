{
  "about": "Golden cases for the evaluation harness (ADR 0017). Times are ISO-8601 durations relative to the moment a run starts (negative: in the past). 'history' adds ordinary daily Singapore card spending (about 100 SGD at merchants m-0 to m-4) ending at 'before'. 'expect' is what an expert analyst would accept; 'expertView' is given to the LLM judge, never to the agents. Chunk sets name the regulation passages that answer the case's regulatory questions.",
  "chunkSets": {
    "transfer-loss-and-reporting": [
      "notice-626-2025:14.2", "notice-626-2025:14.3",
      "srf-2024:6.1", "srf-2024:6.2", "srf-2024:6.3", "srf-2024:6.4", "srf-2024:6.5", "srf-2024:6.7", "srf-2024:6.8",
      "srf-2024:7.13", "srf-2024:7.14",
      "eupg-2024:5.2", "eupg-2024:5.3", "eupg-2024:5.4", "eupg-2024:5.5", "eupg-2024:5.6",
      "eupg-2024:4.21", "srf-2024:4.2.5", "eupg-2024:4.7", "srf-2024:4.2.1", "eupg-2024:4.14", "srf-2024:4.2.4",
      "eupg-2024:3.14"
    ]
  },
  "cases": [
    {
      "id": "geo-impossible-travel",
      "category": "card-fraud",
      "critical": true,
      "description": "Card used in Singapore, then 40 minutes later in London.",
      "expertView": "Physically impossible travel for one card holder: the London card-present payment is almost certainly a cloned card. Likely fraud; block the card and contact the customer.",
      "setup": {
        "account": "acc-geo",
        "history": { "days": 20, "before": "PT0S" },
        "transactions": [
          { "ref": "home", "amount": "84.20", "channel": "CARD_PRESENT", "country": "SG", "counterparty": "m-2", "at": "-PT40M" },
          { "ref": "abroad", "amount": "1290.00", "channel": "CARD_PRESENT", "country": "GB", "counterparty": "m-london-9", "at": "PT0S" }
        ]
      },
      "alert": { "rule": "GEO_JUMP", "severity": "HIGH", "transactions": ["home", "abroad"] },
      "expect": {
        "dispositions": ["LIKELY_FRAUD", "NEEDS_REVIEW"], "minRiskScore": 60,
        "requiredTools": ["getAlertTransactions", "getAccountProfile"]
      }
    },

    {
      "id": "takeover-mule-payee",
      "category": "account-takeover",
      "critical": true,
      "description": "Phone number changed yesterday, a new-device login and a raised transfer limit hours ago, then a transfer to a payee on the mule-account list.",
      "expertView": "Every account-takeover signal is present and the money went to a reported mule account: likely fraud with high confidence. Freeze outgoing transfers, contact the customer on the original number, attempt a recall, file a suspicious transaction report.",
      "setup": {
        "account": "acc-ato",
        "history": { "days": 20, "before": "PT0S" },
        "transactions": [
          { "ref": "transfer", "amount": "8745.00", "channel": "TRANSFER", "country": "SG", "counterparty": "payee-new-4415", "at": "PT0S" }
        ],
        "securityEvents": [
          { "type": "PHONE_NUMBER_CHANGED", "at": "-P1D", "detail": "Changed in online banking from +65 9123 4567 to +65 8765 4321; OTPs now go to the new number" },
          { "type": "NEW_DEVICE_LOGIN", "at": "-PT3H", "detail": "Login from a new device" },
          { "type": "TRANSFER_LIMIT_RAISED", "at": "-PT2H", "detail": "Daily limit raised from 5,000 to 20,000 SGD" }
        ],
        "screenings": [
          { "counterparty": "payee-new-4415", "hits": [ { "list": "MULE_ACCOUNTS", "reason": "Reported by another bank as a money mule account", "listedOn": "-P20D" } ] }
        ]
      },
      "alert": { "rule": "LARGE_AMOUNT", "severity": "HIGH", "transactions": ["transfer"] },
      "expect": {
        "dispositions": ["LIKELY_FRAUD"], "minRiskScore": 80,
        "requiredTools": ["getAccountSecurityEvents", "screenTransferPayees"],
        "regulations": { "required": true, "relevantChunkSet": "transfer-loss-and-reporting" },
        "mustNotContain": ["9123 4567", "8765 4321"]
      }
    },

        ]
      },
      "alert": { "rule": "LARGE_AMOUNT", "severity": "MEDIUM", "transactions": ["transfer"] },
      "expect": {
        "dispositions": ["LIKELY_FRAUD", "NEEDS_REVIEW"], "minRiskScore": 60,

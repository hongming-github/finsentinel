{
  "uid": "finsentinel-pipeline",
  "title": "FinSentinel pipeline",
  "tags": [
    "finsentinel"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Alert to report: payment to stored report",
      "description": "finsentinel.pipeline{stage=total}: event time of the triggering payment to the stored, validated report (ADR 0024).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(finsentinel_pipeline_milliseconds_bucket{stage=\"total\"}[$__rate_interval])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(finsentinel_pipeline_milliseconds_bucket{stage=\"total\"}[$__rate_interval])))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "p95 by stage",
      "description": "detection: Flink; delivery: Kafka to the platform; queue: waiting for a worker; analysis: the agents.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, stage) (rate(finsentinel_pipeline_milliseconds_bucket{stage!=\"total\"}[$__rate_interval])))",
          "legendFormat": "{{stage}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Cases waiting for analysis",
      "description": "Cases in stage ANALYSIS across banks: the backlog under load.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "finsentinel_cases_waiting",
          "legendFormat": "waiting"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Analyses per minute",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(finsentinel_pipeline_milliseconds_count{stage=\"analysis\"}[$__rate_interval])) * 60",
          "legendFormat": "analyses/min"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Model call p95 by answering model",
      "description": "LlmGateway.ask, fallback included. On fake-llm this is the injected latency plus the platform's own work.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, finsentinel_model_answered_by) (rate(finsentinel_llm_ask_milliseconds_bucket[$__rate_interval])))",
          "legendFormat": "{{finsentinel_model_answered_by}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Fallback share and model call errors",
      "description": "The slow-LLM drill (ADR 0024) should show the fallback share rise while failures stay at zero.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum(rate(finsentinel_llm_ask_milliseconds_count{finsentinel_fallback=\"true\"}[$__rate_interval])) or vector(0)) / sum(rate(finsentinel_llm_ask_milliseconds_count[$__rate_interval]))",
          "legendFormat": "answered by the fallback"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum(rate(finsentinel_llm_ask_milliseconds_count{error!=\"none\"}[$__rate_interval])) or vector(0)) / sum(rate(finsentinel_llm_ask_milliseconds_count[$__rate_interval]))",
          "legendFormat": "failed (no provider answered)"
        }
      ]
    }
  ],
  "description": "Phase 9 (ADR 0024): alert-to-report latency by stage, backlog, throughput, model calls. Metrics from the platform's OTLP export (profile 'load')."
}

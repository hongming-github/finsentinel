{
  "priority": 5,
  "request": { "method": "GET", "urlPathPattern": "/core/[^/]+/accounts/[^/]*7" },
  "response": {
    "status": 200,
    "headers": { "Content-Type": "application/json" },
    "jsonBody": {
      "accountId": "{{request.pathSegments.[3]}}",
      "status": "ACTIVE",
      "product": "Everyday Savings",
      "openedOn": "2018-11-20",
      "recentSecurityEvents": [
        { "type": "PHONE_NUMBER_CHANGED", "at": "{{now offset='-1 days'}}", "detail": "Changed in online banking; OTPs now go to the new number" },
        { "type": "NEW_DEVICE_LOGIN", "at": "{{now offset='-3 hours'}}", "detail": "Android device never seen on this customer" },
        { "type": "TRANSFER_LIMIT_RAISED", "at": "{{now offset='-2 hours'}}", "detail": "Daily transfer limit raised from 5,000 to 50,000 SGD" }
      ]
    },
    "transformers": ["response-template"]
  }
}

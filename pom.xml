<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.finsentinel</groupId>
    <artifactId>finsentinel</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>FinSentinel</name>
    <description>Real-time transaction risk detection with AI investigation agents</description>

    <!--
      The root deliberately does NOT inherit spring-boot-starter-parent.
      Only Spring modules import the Boot BOM, so Flink/Spark jobs keep their own
      dependency versions (see docs/adr/0001-modular-monolith.md).
    -->
    <modules>
        <module>common</module>
        <module>contracts</module>
        <module>telemetry</module>
        <module>txn-simulator</module>
        <module>fake-llm</module>
        <module>stream-job</module>
        <module>batch-job</module>
        <module>agent-platform</module>
        <module>mcp-banking</module>
        <module>mcp-compliance</module>
        <module>load-test</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.release>${java.version}</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <spring-boot.version>4.1.1</spring-boot.version>
        <spring-ai.version>2.0.1</spring-ai.version>
        <flink.version>2.3.0</flink.version>
        <flink-connector-kafka.version>5.0.0-2.2</flink-connector-kafka.version>
        <spark.version>4.3.0</spark.version>
        <!-- The version Spring Boot 4.1.1 manages, so the platform and the plain-Java processes run one OpenTelemetry.
             Only the telemetry module uses it: a BOM here would override Boot's management in the platform. -->
        <opentelemetry.version>1.62.0</opentelemetry.version>
        <!-- Logback to OpenTelemetry logs for the platform (ADR 0027): the release built against the OpenTelemetry above.
             Boot does not manage it. -->
        <opentelemetry-logback-appender.version>2.28.1-alpha</opentelemetry-logback-appender.version>
        <kafka.version>4.4.0</kafka.version>
        <!-- Security fixes (ADR 0022 "Upgrades"). Jackson 2 stays on the 2.21 line that Spark 4.2.0
             (jackson-module-scala must match databind's minor) and Spring Boot 4.1.1 use; Jackson 3 on Boot's 3.1 line.
             The Spring modules import these ahead of the Boot BOM, which would otherwise win (see agent-platform). -->
        <jackson2.version>2.22.4</jackson2.version>
        <jackson3.version>3.2.4</jackson3.version>
        <netty.version>4.2.17.Final</netty.version>
        <lz4.version>1.11.4</lz4.version>
        <snappy.version>1.1.10.10</snappy.version>
        <guava.version>33.7.2-jre</guava.version>
        <tomcat.version>11.0.26</tomcat.version>
        <avro.version>1.12.2</avro.version>
        <testcontainers.version>2.0.5</testcontainers.version>
        <slf4j.version>2.0.20</slf4j.version>
        <log4j.version>2.26.1</log4j.version>
        <junit.version>6.1.3</junit.version>
        <assertj.version>3.27.7</assertj.version>
        <!-- Compiler warnings fail the build (-Xlint, see the compiler plugin); -Dmaven.compiler.failOnWarning=false lists
             them all at once. -->
        <maven.compiler.failOnWarning>true</maven.compiler.failOnWarning>
        <errorprone.version>2.50.0</errorprone.version>
        <archunit.version>1.5.1</archunit.version>
        <!-- Load tests (load-test module, ADR 0025); run by hand with gatling:test, never in the build's lifecycle. -->
        <gatling.version>3.16.0</gatling.version>
        <gatling-maven-plugin.version>4.21.12</gatling-maven-plugin.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.finsentinel</groupId>
                <artifactId>common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.finsentinel</groupId>
                <artifactId>contracts</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.finsentinel</groupId>
                <artifactId>telemetry</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.finsentinel</groupId>
                <artifactId>fake-llm</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.avro</groupId>
                <artifactId>avro</artifactId>
                <version>${avro.version}</version>
            </dependency>
            <dependency>
                <groupId>tools.jackson</groupId>
                <artifactId>jackson-bom</artifactId>
                <version>${jackson3.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- Jackson 2 arrives through Avro, Spark and the Flink Kafka connector, each on its own version; one
                 patched version for all of them. -->
            <dependency>
                <groupId>com.fasterxml.jackson</groupId>
                <artifactId>jackson-bom</artifactId>
                <version>${jackson2.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- Spark 4.2.0 brings Netty 4.2.13; the version Spring Boot 4.1.1 manages. -->
            <dependency>
                <groupId>io.netty</groupId>
                <artifactId>netty-bom</artifactId>
                <version>${netty.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.apache.kafka</groupId>
                <artifactId>kafka-clients</artifactId>
                <version>${kafka.version}</version>
            </dependency>
            <!-- kafka-clients 4.2.1 brings lz4-java 1.10.1 (4.2.2 still 1.11.2) and Spark 4.2.0 brings 1.11.0. -->
            <dependency>
                <groupId>at.yawk.lz4</groupId>
                <artifactId>lz4-java</artifactId>
                <version>${lz4.version}</version>
            </dependency>
            <!-- kafka-clients 4.2.1 brings snappy-java 1.1.10.7 and Spark 4.2.0 brings 1.1.10.8; Boot manages neither. -->
            <dependency>
                <groupId>org.xerial.snappy</groupId>
                <artifactId>snappy-java</artifactId>
                <version>${snappy.version}</version>
            </dependency>
            <!-- Spark 4.2.0 brings Guava 32.0.0-jre (through curator-client); Spark's own copy is shaded. -->
            <dependency>
                <groupId>com.google.guava</groupId>
                <artifactId>guava</artifactId>
                <version>${guava.version}</version>
            </dependency>
            <dependency>
                <groupId>org.slf4j</groupId>
                <artifactId>slf4j-api</artifactId>
                <version>${slf4j.version}</version>
            </dependency>
            <dependency>
                <groupId>org.slf4j</groupId>
                <artifactId>slf4j-simple</artifactId>
                <version>${slf4j.version}</version>
            </dependency>
            <!-- Aligned with Spark 4.2.0's log4j (api, core and bridges on one version). -->
            <dependency>
                <groupId>org.apache.logging.log4j</groupId>
                <artifactId>log4j-api</artifactId>
                <version>${log4j.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.logging.log4j</groupId>
                <artifactId>log4j-slf4j2-impl</artifactId>
                <version>${log4j.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.logging.log4j</groupId>
                <artifactId>log4j-core</artifactId>
                <version>${log4j.version}</version>
            </dependency>
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>${junit.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.assertj</groupId>
                <artifactId>assertj-core</artifactId>
                <version>${assertj.version}</version>
            </dependency>
            <dependency>
                <groupId>com.tngtech.archunit</groupId>
                <artifactId>archunit</artifactId>
                <version>${archunit.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.16.0</version>
                    <configuration>
                        <parameters>true</parameters>
                        <showWarnings>true</showWarnings>
                        <compilerArgs>
                            <!-- Every lint category except three that only flag idioms or the classpath here: serial
                                 (Java serialization only ships Flink functions within one build and is never used for
                                 stored data; Flink state has its own serializers, see SerializationTest), try
                                 (scope-style try-with-resources such as tracing and tenancy scopes never reference the
                                 resource) and processing (a test dependency ships an annotation processor that claims
                                 none of our annotations). -->
                            <arg>-Xlint:all,-serial,-try,-processing</arg>
                            <!-- Error Prone: compile-time bug patterns, warnings fail the build like javac's. Runs
                                 inside javac, which needs the exports in .mvn/jvm.config. Generated Avro code is not
                                 ours to fix. Off: MissingSummary (records document themselves with @param only) and
                                 StringSplitter (the chunker relies on String.split's documented behaviour, and its
                                 output is pinned by RetrievalEvalTest). -->
                            <arg>-XDcompilePolicy=simple</arg>
                            <arg>-XDaddTypeAnnotationsToSymbol=true</arg>
                            <arg>--should-stop=ifError=FLOW</arg>
                            <arg>-Xplugin:ErrorProne -XepDisableWarningsInGeneratedCode -XepExcludedPaths:.*/target/generated-sources/.* -Xep:MissingSummary:OFF -Xep:StringSplitter:OFF</arg>
                        </compilerArgs>
                        <annotationProcessorPaths>
                            <path>
                                <groupId>com.google.errorprone</groupId>
                                <artifactId>error_prone_core</artifactId>
                                <version>${errorprone.version}</version>
                            </path>
                        </annotationProcessorPaths>
                    </configuration>
                </plugin>
                <!-- Lifecycle plugins pinned rather than taken from Maven's defaults (requirePluginVersions). -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-clean-plugin</artifactId>
                    <version>3.5.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-resources-plugin</artifactId>
                    <version>3.5.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>3.5.1</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-install-plugin</artifactId>
                    <version>3.2.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-deploy-plugin</artifactId>
                    <version>3.2.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-site-plugin</artifactId>
                    <version>3.22.0</version>
                </plugin>
                <!-- SBOM of everything we ship (CI: ./mvnw cyclonedx:makeAggregateBom), for supply-chain review. -->
                <plugin>
                    <groupId>org.cyclonedx</groupId>
                    <artifactId>cyclonedx-maven-plugin</artifactId>
                    <version>2.9.3</version>
                    <configuration>
                        <projectType>application</projectType>
                        <outputFormat>json</outputFormat>
                        <outputName>bom</outputName>
                        <includeTestScope>false</includeTestScope>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-enforcer-plugin</artifactId>
                    <version>3.6.3</version>
                    <executions>
                        <!-- Dormant (phase none): a module that must stay Spring-free or dependency-free turns its
                             execution on by redeclaring it with <phase>validate</phase> (ADR 0022). -->
                        <execution>
                            <id>no-spring</id>
                            <phase>none</phase>
                            <goals>
                                <goal>enforce</goal>
                            </goals>
                            <configuration>
                                <rules>
                                    <bannedDependencies>
                                        <message>This module must not depend on Spring (ADR 0001): the Flink job, the
                                            batch job and their shared contracts run without it.</message>
                                        <excludes>
                                            <exclude>org.springframework*</exclude>
                                            <exclude>com.alibaba.cloud.ai*</exclude>
                                        </excludes>
                                    </bannedDependencies>
                                </rules>
                            </configuration>
                        </execution>
                        <execution>
                            <id>no-runtime-dependencies</id>
                            <phase>none</phase>
                            <goals>
                                <goal>enforce</goal>
                            </goals>
                            <configuration>
                                <rules>
                                    <bannedDependencies>
                                        <message>common is shared by every module and stays free of runtime
                                            dependencies; test-scope libraries are fine.</message>
                                        <excludes>
                                            <exclude>*:*:*:*:compile</exclude>
                                            <exclude>*:*:*:*:runtime</exclude>
                                            <exclude>*:*:*:*:provided</exclude>
                                            <exclude>*:*:*:*:system</exclude>
                                        </excludes>
                                    </bannedDependencies>
                                </rules>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.6.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-failsafe-plugin</artifactId>
                    <version>3.6.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-shade-plugin</artifactId>
                    <version>3.6.2</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.avro</groupId>
                    <artifactId>avro-maven-plugin</artifactId>
                    <version>${avro.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>exec-maven-plugin</artifactId>
                    <version>3.6.4</version>
                </plugin>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>enforce</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireJavaVersion>
                                    <version>[21,)</version>
                                </requireJavaVersion>
                                <requireMavenVersion>
                                    <version>[3.9,)</version>
                                </requireMavenVersion>
                                <!-- Reproducible builds: no plugin falls back to whatever version Maven defaults to. -->
                                <requirePluginVersions/>
                                <banDuplicatePomDependencyVersions/>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
